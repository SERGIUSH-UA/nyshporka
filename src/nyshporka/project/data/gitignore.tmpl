# Історія простору Нишпорки (`nysh history`): що НЕ йде в git.
#
# Іде: канон, профілі й конфіги, сховище сторінок і погляд проєкту, паспорти
# справ, докази-вирізки. Не йде: кадри, прочитане рушієм, похідне, збірки —
# воно велике й відтворюється. Шаблон із `**/` діє й у теках projects/<ім'я>/:
# git прив'язує шаблон зі скісною всередині до теки цього файла.

# Кадри справ — великі, лежать у архіві й качаються знову; паспорти — ні.
data/raw/**
!data/raw/**/
!data/raw/**/_source.json
!data/raw/**/_offloaded.json

# Прочитане рушієм і похідне: стор тексту, реєстр, бази, кеші.
reports/htr/
**/data/derived/
**/data/cache/
**/data/train/
**/data/spotter/weights/

# Журнали переїзду проєкту й розщеплення сторінок (свої архіви поза git).
**/data/cases/adopt/
**/data/cases/pages-split/

# Збірки сайту роду й лендінгу — перезбираються з канону.
site/
site_public/
landing_site/

# Середовища, бази, службове.
.venv*/
__pycache__/
*.sqlite
*.sqlite-*
*.sqlite3
*.lock
*.part
