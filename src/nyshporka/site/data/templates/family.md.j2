{% from "_macros.j2" import pcard, kin_group, gallery %}
{% set _h = card(family.husband) if family.husband else None %}
{% set _w = card(family.wife) if family.wife else None %}
---
title: Родина {{ family.id }}
---

<div class="nysh-hero nysh-hero--family" markdown>
<div class="nysh-hero__text" markdown>

# {% if _h and _w %}{{ _h.name }} і {{ _w.name }}{% elif _h or _w %}Родина: {{ (_h or _w).name }}{% else %}Родина {{ family.id }}{% endif %}

<p class="nysh-hero__years">Родина · {{ family.children | length }} {{ "дитина" if family.children | length == 1 else "дітей" }}</p>
</div>
</div>

<div class="nysh-kin" markdown>
{{ kin_group("Подружжя", [_h, _w] | select | list) }}
{% if family.children %}
<div class="nysh-kin__group" markdown>
<div class="nysh-kin__label">Діти</div>
<div class="nysh-kin__cards" markdown>
{% for cid in family.children %}
{{ pcard(card(cid)) }}
{% endfor %}
</div>
</div>
{% endif %}
</div>

{% if family.hypothetical_husband or family.hypothetical_wife or family.hypothetical_children %}
## Гіпотетичні члени

<p class="nysh-note">Не верифіковано джерелом: зв'язок виведено непрямо.</p>

<div class="nysh-kin nysh-kin--hyp" markdown>
<div class="nysh-kin__group" markdown>
<div class="nysh-kin__cards" markdown>
{% for pid in [family.hypothetical_husband, family.hypothetical_wife] if pid %}
{{ pcard(card(pid, True)) }}
{% endfor %}
{% for cid in family.hypothetical_children %}
{{ pcard(card(cid, True)) }}
{% endfor %}
</div>
</div>
</div>
{% endif %}

{% if family.facts %}
## Події

<ol class="nysh-life">
{% for f in family.facts %}
<li class="nysh-life__item nysh-life__item--{{ f.type }}" markdown="1">
<span class="nysh-life__date">{{ f.date | format_date if f.date else "без дати" }}</span>
<span class="nysh-life__what" markdown="span">**{{ f.type | fact_label }}**{% if f.place_id and f.place_id in place_names %} · [{{ place_names[f.place_id] }}](../places/{{ f.place_id }}.md){% endif %}{{ cite_marks(f) }}</span>
{% if f.value %}

{{ f.value }}
{% endif %}
</li>
{% endfor %}
</ol>
{% endif %}

{% if documents %}
## Документи

{{ gallery(documents) }}
{% endif %}

{% if family.notes %}
## Нотатки

{{ family.notes }}
{% endif %}

<p class="nysh-meta">ID <code>{{ family.id }}</code>{% if family.aliases %} · інші ID: {{ family.aliases | join(", ") }}{% endif %}</p>

{% for s in all_sources %}
[^{{ s.id }}]: {{ s.title if s.withheld else "[" ~ s.title ~ "](../sources/" ~ s.id ~ ".md)" }}
{% endfor %}
