# Згенеровано `nysh site build` — правки тут перетре наступна збірка.
# Назву, пороги приватності, групи місць, мови й власні сторінки задає
# data/site/site.yml; власні сторінки лежать у data/site/overlay/.
site_name: {{ title | tojson }}
site_description: {{ description | tojson }}
use_directory_urls: false
docs_dir: {{ docs_dir | tojson }}
site_dir: {{ site_dir | tojson }}

theme:
  name: material
  language: {{ language }}
  features:
    - navigation.tabs
    - navigation.indexes
    - navigation.top
    - navigation.footer
    - search.suggest
    - search.highlight
    - toc.follow
  palette:
    - media: "(prefers-color-scheme: light)"
      scheme: default
      primary: custom
      accent: custom
      toggle:
        icon: material/weather-night
    - media: "(prefers-color-scheme: dark)"
      scheme: slate
      primary: custom
      accent: custom
      toggle:
        icon: material/weather-sunny
  font: false
  icon:
    logo: material/family-tree

{% if alternate | length > 1 %}
# Перемикач мов: кожна мова — окрема збірка тієї самої структури, тож
# `assets/js/site.js` веде на ту саму сторінку іншою мовою.
extra:
  alternate:
{% for alt in alternate %}
    - name: {{ alt.name | tojson }}
      link: {{ alt.link | tojson }}
      lang: {{ alt.lang }}
{% endfor %}
{% endif %}

markdown_extensions:
  - admonition
  - footnotes
  - attr_list
  - md_in_html
  - tables
  - toc:
      permalink: true
  - pymdownx.details
  - pymdownx.superfences

plugins:
  - search:
      lang: {{ search_langs | tojson }}
  - roamlinks

hooks:
  - {{ hooks_path | tojson }}

extra_css:
  - assets/css/theme.css
  - assets/css/tree.css
  - assets/css/map.css
  - assets/css/graph.css
{% for css in extra_css %}
  - {{ css | tojson }}
{% endfor %}

extra_javascript:
  - path: assets/js/site.js
    type: module

nav:
  - {{ t("nav.home") | tojson }}: index.md
{% for item in nav_before %}
  - {{ item.title | tojson }}: {{ item.path | tojson }}
{% endfor %}
  - {{ t("nav.tree") | tojson }}: family-tree.md
  - {{ t("nav.persons") | tojson }}:
      - persons/index.md
      - {{ t("nav.families") | tojson }}: families/index.md
      - {{ t("nav.hypotheses") | tojson }}: hypotheses/index.md
      - {{ t("nav.graph") | tojson }}: family-graph.md
  - {{ t("nav.places") | tojson }}:
      - places/index.md
      - {{ t("nav.map") | tojson }}: places-map.md
  - {{ t("nav.sources") | tojson }}: sources/index.md
{% for item in nav_after %}
  - {{ item.title | tojson }}: {{ item.path | tojson }}
{% endfor %}
