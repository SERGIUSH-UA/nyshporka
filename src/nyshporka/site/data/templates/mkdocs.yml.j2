# Згенеровано `nysh site build` — правки тут перетре наступна збірка.
# Назву, пороги приватності, групи місць і власні сторінки задає
# data/site/site.yml; власні сторінки лежать у data/site/overlay/.
site_name: {{ title | tojson }}
site_description: {{ description | tojson }}
use_directory_urls: false
docs_dir: docs
site_dir: html

theme:
  name: material
  language: {{ language }}
  features:
    - navigation.tabs
    - navigation.indexes
    - navigation.top
    - navigation.footer
    - search.suggest
    - search.highlight
    - toc.follow
  palette:
    - media: "(prefers-color-scheme: light)"
      scheme: default
      primary: custom
      accent: custom
      toggle:
        icon: material/weather-night
        name: Темна тема
    - media: "(prefers-color-scheme: dark)"
      scheme: slate
      primary: custom
      accent: custom
      toggle:
        icon: material/weather-sunny
        name: Світла тема
  font: false
  icon:
    logo: material/family-tree

markdown_extensions:
  - admonition
  - footnotes
  - attr_list
  - md_in_html
  - tables
  - toc:
      permalink: true
  - pymdownx.details
  - pymdownx.superfences

plugins:
  - search:
      lang: {{ search_langs | tojson }}
  - roamlinks

hooks:
  - {{ hooks_path | tojson }}

extra_css:
  - assets/css/theme.css
  - assets/css/tree.css
  - assets/css/map.css
  - assets/css/graph.css
{% for css in extra_css %}
  - {{ css | tojson }}
{% endfor %}

extra_javascript:
  - assets/js/site.js

nav:
  - Головна: index.md
{% for item in nav_before %}
  - {{ item.title | tojson }}: {{ item.path | tojson }}
{% endfor %}
  - Дерево: family-tree.md
  - Особи:
      - persons/index.md
      - Родини: families/index.md
      - Граф зв'язків: family-graph.md
  - Місця:
      - places/index.md
      - Мапа: places-map.md
  - Джерела: sources/index.md
{% for item in nav_after %}
  - {{ item.title | tojson }}: {{ item.path | tojson }}
{% endfor %}
