---
title: {{ t("nav.persons") | q }}
hide:
  - toc
---

# {{ t("nav.persons") }}

<div class="nysh-filter" data-filter-target=".nysh-plist">
<input type="search" class="nysh-filter__input" placeholder="{{ t('idx.persons.filter') }}" aria-label="{{ t('idx.persons.filter') }}" autocomplete="off">
<span class="nysh-filter__count">{{ t("idx.persons.count", n=persons | length) }}</span>
</div>

<nav class="nysh-jumpbar" aria-label="{{ t('by.letter') }}">
{% for lt in letters %}
<a class="nysh-jumpchip" href="#{{ lt | lower | replace('—', 'other') }}">{{ lt }}</a>
{% endfor %}
</nav>

{% for lt in letters %}

## {{ lt }} { #{{ lt | lower | replace('—', 'other') }} .nysh-plist__letter }

<div class="nysh-plist" markdown>
{% for p in grouped[lt] %}
[<span class="nysh-pc__name">{{ p.primary_name }}</span><span class="nysh-pc__years">{{ p.years or t("years.unknown") }}{% if p.birth_place_name %} · {{ p.birth_place_name }}{% endif %}</span>]({{ p.id }}.md){ .nysh-pc .nysh-pc--{{ p.sex | lower }}{% if p.private %} .is-private{% endif %} }
{% endfor %}
</div>

{% endfor %}
