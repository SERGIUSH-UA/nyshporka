---
title: {{ t("map.title") | q }}
hide:
  - navigation
  - toc
---

<link rel="stylesheet" href="assets/vendor/leaflet.css">

<div id="nysh-map" class="nysh-map nysh-app" data-geojson-url="assets/places.geojson"
     data-groups="{{ place_groups_json | e }}" data-eras="{{ eras_json | e }}">
<div class="nysh-map__bar nysh-app__bar">
<div class="nysh-chips" data-role="groups" aria-label="{{ t('map.groups') }}"></div>
<div class="nysh-chips" data-role="eras" aria-label="{{ t('map.eras') }}"></div>
</div>
<div class="nysh-map__body nysh-app__body">
<div class="nysh-map__canvas"></div>
<aside class="nysh-panel nysh-map__list" data-state="peek">
<button type="button" class="nysh-panel__grip" aria-label="{{ t('map.list') }}"><span></span></button>
<div class="nysh-panel__body"></div>
</aside>
</div>
<p class="nysh-meta">{{ t("map.meta", a=counts.places_with_coords, b=counts.places) }}{% if counts.places_with_coords < counts.places %}{{ t("map.meta.rest") }}{% endif %}.</p>
</div>

<script src="assets/vendor/leaflet.js"></script>
<script type="module" src="assets/js/places-map.js"></script>
