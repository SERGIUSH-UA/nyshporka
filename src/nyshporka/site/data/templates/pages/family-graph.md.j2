---
title: Граф зв'язків
hide:
  - navigation
  - toc
---

<div id="nysh-graph" class="nysh-graph nysh-app" data-graph-url="assets/tree.json" data-index-url="assets/search.json"
     data-year-min="{{ year_min }}" data-year-max="{{ year_max }}">
<div class="nysh-graph__bar nysh-app__bar">
<div class="nysh-search nysh-search--compact">
<input type="search" class="nysh-search__input" placeholder="Знайти особу…" aria-label="Знайти особу на графі" autocomplete="off" spellcheck="false">
<ul class="nysh-search__list" role="listbox" hidden></ul>
</div>
<label class="nysh-graph__year"><span>Жили в <b data-out="year">усі роки</b></span>
<input type="range" min="{{ year_min }}" max="{{ year_max + 1 }}" value="{{ year_max + 1 }}" step="1" aria-label="Рік"></label>
<label class="nysh-check"><input type="checkbox" data-opt="hyp" checked> гіпотези</label>
</div>
<div class="nysh-graph__body nysh-app__body">
<div class="nysh-tree__canvas">
<canvas class="nysh-graph__canvas" aria-label="Граф зв'язків роду"></canvas>
<div class="nysh-tree__zoom">
<button type="button" data-act="zoom+" aria-label="Наблизити">+</button>
<button type="button" data-act="zoom-" aria-label="Віддалити">−</button>
<button type="button" data-act="fit" aria-label="Показати все">⤢</button>
</div>
<div class="nysh-tree__status">Завантаження…</div>
</div>
<aside class="nysh-panel" data-state="closed" aria-live="polite">
<button type="button" class="nysh-panel__grip" aria-label="Розгорнути або згорнути деталі"><span></span></button>
<div class="nysh-panel__body"></div>
</aside>
</div>
<p class="nysh-meta">Вузол — особа, колір — гілка (зв'язна частина роду), лінія — батьки й діти, пунктир — гіпотеза. Повзунок лишає тих, хто жив у вибраний рік.</p>
</div>

<script src="assets/vendor/d3.min.js"></script>
<script type="module" src="assets/js/family-graph.js"></script>
