---
title: {{ title | q }}
hide:
  - navigation
  - toc
---

<div class="nysh-home">

<section class="nysh-home__hero">
<h1 class="nysh-home__title">{{ title }}</h1>
{% if description %}
<p class="nysh-home__lead">{{ description }}</p>
{% endif %}
<div class="nysh-search" data-index-url="assets/search.json" data-base="" data-tree="family-tree.html">
<input type="search" class="nysh-search__input" placeholder="{{ t('home.search') }}" aria-label="{{ t('home.search.aria') }}" autocomplete="off" spellcheck="false">
<ul class="nysh-search__list" role="listbox" hidden></ul>
</div>
<p class="nysh-home__years">{{ year_min }} — {{ year_max }}</p>
</section>

<section class="nysh-stats">
<a class="nysh-stat" href="persons/index.html"><span class="nysh-stat__n">{{ counts.persons }}</span><span class="nysh-stat__l">{{ t("home.persons") }}</span></a>
<a class="nysh-stat" href="families/index.html"><span class="nysh-stat__n">{{ counts.families }}</span><span class="nysh-stat__l">{{ t("home.families") }}</span></a>
<a class="nysh-stat" href="places/index.html"><span class="nysh-stat__n">{{ counts.places }}</span><span class="nysh-stat__l">{{ t("home.places") }}</span></a>
<a class="nysh-stat" href="sources/index.html"><span class="nysh-stat__n">{{ counts.sources }}</span><span class="nysh-stat__l">{{ t("home.sources") }}</span></a>
</section>

<section class="nysh-tiles">
<a class="nysh-tile nysh-tile--tree" href="family-tree.html">
<span class="nysh-tile__title">{{ t("tile.tree") }}</span>
<span class="nysh-tile__text">{{ t("tile.tree.text") }}</span>
</a>
<a class="nysh-tile nysh-tile--map" href="places-map.html">
<span class="nysh-tile__title">{{ t("tile.map") }}</span>
<span class="nysh-tile__text">{{ t("tile.map.text", n=counts.places_with_coords) }}</span>
</a>
<a class="nysh-tile nysh-tile--persons" href="persons/index.html">
<span class="nysh-tile__title">{{ t("tile.persons") }}</span>
<span class="nysh-tile__text">{{ t("tile.persons.text") }}</span>
</a>
{% if counts.hypotheses %}
<a class="nysh-tile nysh-tile--hyp" href="hypotheses/index.html">
<span class="nysh-tile__title">{{ t("tile.hyp") }}</span>
<span class="nysh-tile__text">{{ t("tile.hyp.text", n=counts.hypotheses) }}</span>
</a>
{% endif %}
<a class="nysh-tile nysh-tile--graph" href="family-graph.html">
<span class="nysh-tile__title">{{ t("tile.graph") }}</span>
<span class="nysh-tile__text">{{ t("tile.graph.text") }}</span>
</a>
{% for item in nav_extra %}
<a class="nysh-tile" href="{{ item.path | replace('.md', '.html') }}">
<span class="nysh-tile__title">{{ item.title }}</span>
</a>
{% endfor %}
</section>

<section class="nysh-home__about">
<p>{{ t("home.about", a=counts.facts_cited, b=counts.facts) }}</p>
{% if public %}
<p class="nysh-note">{{ t("home.public") }}</p>
{% else %}
<p class="nysh-note nysh-note--warn">{{ t("home.private") }}</p>
{% endif %}
<p class="nysh-meta">{{ t("home.built", d=built) }}</p>
</section>

</div>

<script type="module" src="assets/js/home.js"></script>
