</div>
<div class="nysh-stepper" title="Поколінь нащадків">
<button type="button" data-act="down-" aria-label="Менше поколінь нащадків">−</button>
<span><span class="nysh-stepper__ico" aria-hidden="true">▼</span><b data-out="down">2</b></span>
<button type="button" data-act="down+" aria-label="Більше поколінь нащадків">+</button>
</div>
<button type="button" class="nysh-tool" data-act="root" title="До найдавнішого предка">До кореня</button>
